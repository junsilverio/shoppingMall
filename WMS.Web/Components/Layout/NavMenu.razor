@code {
    private string CurrentPath => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();

    private string IsActive(string path)
    {
        var current = CurrentPath;
        var target = path.TrimEnd('/').ToLowerInvariant();
        return current == target ? "active" : string.Empty;
    }

    private string HasChild(string section)
    {
        return CurrentPath.StartsWith("/" + section, StringComparison.OrdinalIgnoreCase) ? "active open" : string.Empty;
    }

    private string SubMenuOpen(string section)
    {
        return CurrentPath.StartsWith("/" + section, StringComparison.OrdinalIgnoreCase) ? "show" : string.Empty;
    }
}
